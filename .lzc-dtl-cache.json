{
  "name": "Ryot",
  "package": "cloud.lazycat.app.ryot",
  "description": "一个用于追踪生活各方面的自托管平台",
  "homepage": "https://ryot.io",
  "author": "ryot",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "ryot",
  "version": "8.5.0",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "ryot_8000_8000": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_postgres_16-alpine": {
    "originalImage": "postgres:16-alpine",
    "pushTarget": "none"
  },
  "ryot-db_volume_postgres_storage_/var/lib/postgresql/data_action": "emptyDir",
  "ryot-db_volume_/var/lib/postgresql/data_location": "app_data",
  "image_ignisda_ryot_v8": {
    "originalImage": "ignisda/ryot:v8",
    "pushTarget": "none"
  }
}
